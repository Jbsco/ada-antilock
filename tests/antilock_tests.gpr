with "config/antilock_tests_config.gpr";
with "antilock_core.gpr";
project Antilock_Tests is

   for Source_Dirs use ("src/", "generated/", "config/");
   for Object_Dir use "obj/" & Antilock_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("scenario_check.adb");

   package Compiler is
      for Default_Switches ("Ada") use Antilock_Tests_Config.Ada_Compiler_Switches &
        ("-gnatyM120", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Antilock_Tests;
