with "config/antilock_core_config.gpr";
project Antilock_Core is

   for Library_Name use "antilock_core";
   for Library_Version use Project'Library_Name & ".so." & Antilock_Core_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Antilock_Core_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ANTILOCK_CORE_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Antilock_Core_Config.Ada_Compiler_Switches &
        ("-gnatyM120", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2",
         "--steps=200000",
         "--timeout=300",
         "--report=all",
         "--output-header",
         "--checks-as-errors=on",
         "--warnings=error");
   end Prove;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Antilock_Core;
